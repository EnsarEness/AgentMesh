# Copy to .env and adjust. Used by Node (api/server.js) and optionally documented for Flask.

# ─── Express (npm run start:api) ───────────────────────────────────────────
PORT=3000

# Flask backend base URL (no trailing slash). Required for /health and all proxied routes.
# Local: run `python backend/app.py` or `npm run dev` (starts Flask on 5001).
PYTHON_BACKEND=http://127.0.0.1:5001

# Supabase (backend — copy into shell or a .env loaded by python-dotenv)
# SUPABASE_URL=
# SUPABASE_KEY=

# Optional: real job execution (backend/job.py)
# OPENAI_API_KEY=

# On Vercel, leave PYTHON_BACKEND unset: the API resolves https://<VERCEL_URL>/python-api
